  "format": "ssr.game-plan.v1",
  "plan_id": "peak-expedition-v1",
  "game": "PEAK:3527290",
  "analysis": {
    "core_loop": "先選路線與補給，再依區域危險保留合適道具；攀爬時消耗主體力，必要時用額外體力完成路段，並救援失去行動能力的隊友。",
    "structure": "食物保留在道具分類，分列效果、取得、操作與限制；區域描述地形及風險；狀態解釋成因與恢復；機制說明規則；攻略只組合已有來源支持的操作。沿用自己的分類，不複製 Wiki 導覽。",
    "basis_url": "https://peak.wiki.gg/wiki/Level",
    "basis_sections": [
      "六段行程與替代區域",
      "食物生食／烹煮效果",
      "炎熱、孢子、嗜睡",
      "裝備操作與救援"
    ],
    "version_policy": "依 2026-10-21 實際取得的有界索引文字保存固定來源。食物原始與烹煮總效果分開；救援爪採詳細條目的遊戲內公尺，不混用總表的數字。區域先後依六段行程記錄，不把舊頁的每兩天輪替寫成固定排程。官方更新沿用原計畫目標並單獨使用官方證據。",
    "exclusions": [
      "本批不宣稱全部道具、天然食物、徽章與世界觀完整。",
      "不補造未查明的昏迷固定倒數秒數。",
      "不把官方公告所說的修正寫成已完成遊戲實測。"
    ],
    "questions": [
      "食物未煮及煮熟後分別補多少？",
      "第三區如何防曬或避開暴風雪？",
      "額外體力何時消耗？",
      "如何使用噴射背包和救援爪？",
      "孢子感染與一般孢子累積有何不同？"
    ]
  },
